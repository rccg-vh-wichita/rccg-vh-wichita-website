---
import Arrow from './Arrow.astro';
import { withBase } from '../utils/paths';
import { church } from '../data/site';
---

<section class="visit-cta">
  <div class="wrap visit-cta-inner reveal">
    <div>
      <p class="eyebrow">Join us this Sunday</p>
      <h2>We would love to<br /><em>welcome you.</em></h2>
    </div>
    <div class="visit-cta-action">
      <p>Sunday worship begins at 10:00 AM at 1701 S Sedgwick St. If it is your first time, come in and make yourself at home.</p>
      <a class="btn btn-light" href={withBase('/visit-us/')}>Plan your visit <Arrow /></a>
      <a class="directions" href={church.mapUrl} target="_blank" rel="noreferrer">Get directions</a>
    </div>
  </div>
</section>

<style>
  .visit-cta {
    position: relative;
    overflow: hidden;
    padding: clamp(80px, 11vw, 150px) 0;
    color: var(--white);
    background: linear-gradient(110deg, var(--forest) 0 72%, var(--coral) 72%);
  }

  .visit-cta::after {
    position: absolute;
    top: -180px;
    right: -70px;
    width: 430px;
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 50%;
    box-shadow: 0 0 0 56px rgba(255, 255, 255, 0.06);
    content: '';
  }

  .visit-cta-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.6fr 0.7fr;
    align-items: end;
    gap: clamp(40px, 8vw, 130px);
  }

  .visit-cta .eyebrow {
    color: var(--gold);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.8rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  h2 em {
    color: var(--gold);
    font-weight: inherit;
  }

  .visit-cta-action p {
    margin: 0 0 26px;
    opacity: 0.72;
  }

  .directions {
    display: block;
    width: max-content;
    margin-top: 18px;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    font-size: 0.78rem;
    font-weight: 700;
    opacity: 0.75;
  }

  @media (max-width: 760px) {
    .visit-cta {
      background: var(--forest);
    }

    .visit-cta-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
