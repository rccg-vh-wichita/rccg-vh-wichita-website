---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image?: ImageMetadata;
  imageAlt?: string;
  dark?: boolean;
  layout?: 'cover' | 'split' | 'poster';
}

const { eyebrow, title, intro, image, imageAlt = '', dark = false, layout = 'cover' } = Astro.props;
---

<section class:list={['page-hero', layout, { dark, 'with-image': image }]}> 
  {image && (
    <div class="page-hero-media">
      <Image src={image} alt={imageAlt} width={1920} widths={[720, 1200, 1920]} sizes="100vw" loading="eager" />
    </div>
  )}
  <div class="wrap page-hero-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display">{title}</h1>
    <p class="page-hero-intro">{intro}</p>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 68vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--cream);
  }

  .page-hero.dark {
    color: var(--white);
    background: var(--forest-deep);
  }

  .page-hero.dark::before {
    position: absolute;
    top: 16%;
    right: 8%;
    width: min(34vw, 460px);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 50%;
    box-shadow: 0 0 0 70px rgba(227, 163, 75, 0.06), 0 0 0 140px rgba(14, 169, 158, 0.035);
    content: '';
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
  }

  .page-hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .with-image::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(14, 24, 34, 0.92) 0%, rgba(14, 24, 34, 0.58) 50%, rgba(14, 24, 34, 0.12) 100%),
      linear-gradient(to top, rgba(14, 24, 34, 0.42), transparent 55%);
    content: '';
  }

  .page-hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(100px, 14vw, 180px);
    padding-bottom: clamp(68px, 8vw, 116px);
  }

  .with-image .page-hero-inner {
    color: var(--white);
  }

  .with-image .eyebrow,
  .dark .eyebrow {
    color: var(--gold);
  }

  .page-hero-intro {
    max-width: 620px;
    margin: 28px 0 0;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.6;
    opacity: 0.82;
  }

  .page-hero.split {
    min-height: 660px;
    color: var(--ink);
    background: var(--sunwash);
  }

  .split .page-hero-media {
    left: 56%;
    overflow: hidden;
    border-bottom-left-radius: clamp(100px, 14vw, 230px);
  }

  .split.with-image::after {
    display: none;
  }

  .split .page-hero-inner {
    display: grid;
    padding-right: 0;
    grid-template-columns: minmax(420px, 540px) 1fr;
  }

  .split .page-hero-inner > * {
    grid-column: 1;
  }

  .split .display {
    max-width: 660px;
    font-size: clamp(3.3rem, 5.2vw, 5.7rem);
    line-height: 0.96;
  }

  .split.with-image .page-hero-inner {
    color: var(--ink);
  }

  .split.with-image .eyebrow {
    color: var(--coral);
  }

  .split .page-hero-intro {
    max-width: 560px;
    opacity: 0.72;
  }

  .page-hero.poster {
    min-height: 720px;
    color: var(--white);
    background: var(--forest-deep);
  }

  .poster .page-hero-media {
    inset: 54px 3vw 0 34%;
    overflow: hidden;
    border-top-left-radius: 190px;
  }

  .poster.with-image::after {
    background: linear-gradient(90deg, rgba(14, 24, 34, 1) 0%, rgba(14, 24, 34, 0.96) 31%, rgba(14, 24, 34, 0.42) 58%, rgba(14, 24, 34, 0.08));
  }

  .poster .page-hero-inner {
    padding-bottom: 76px;
  }

  .poster .display {
    max-width: 780px;
    font-size: clamp(3.8rem, 6.6vw, 7rem);
    line-height: 0.9;
  }

  .poster .page-hero-intro {
    position: absolute;
    right: 0;
    bottom: 58px;
    width: min(32%, 390px);
    margin: 0;
    padding: 22px 24px;
    color: var(--forest-deep);
    background: var(--gold);
    font-size: 0.98rem;
    opacity: 1;
  }

  @media (max-width: 1100px) {
    .split .page-hero-media {
      left: 59%;
    }

    .split .display {
      font-size: clamp(3.15rem, 5.7vw, 4.6rem);
    }

    .poster .display {
      max-width: 640px;
      font-size: clamp(3.5rem, 6.6vw, 5.5rem);
    }
  }

  @media (max-width: 900px) {
    .page-hero {
      min-height: 62vh;
    }

    .with-image::after {
      background: linear-gradient(to top, rgba(14, 24, 34, 0.94), rgba(14, 24, 34, 0.28));
    }

    .page-hero.split,
    .page-hero.poster {
      min-height: 72vh;
      color: var(--white);
      background: var(--forest-deep);
    }

    .split .page-hero-media,
    .poster .page-hero-media {
      left: 0;
      inset: 0;
      border-radius: 0;
    }

    .split.with-image::after,
    .poster.with-image::after {
      display: block;
      background: linear-gradient(to top, rgba(14, 24, 34, 0.94), rgba(14, 24, 34, 0.28));
    }

    .split .page-hero-inner,
    .poster .page-hero-inner {
      display: block;
      padding-right: 0;
    }

    .split.with-image .page-hero-inner {
      color: var(--white);
    }

    .split.with-image .eyebrow {
      color: var(--gold);
    }

    .split .display,
    .poster .display {
      font-size: clamp(3.2rem, 12vw, 5.1rem);
    }

    .poster .page-hero-intro {
      position: static;
      width: auto;
      margin-top: 24px;
      padding: 0;
      color: inherit;
      background: transparent;
      opacity: 0.82;
    }
  }
</style>
