---
import Arrow from './Arrow.astro';
import { Image } from 'astro:assets';
import churchLogo from '../assets/images/victory-house-logo.png';
import { mainNav } from '../data/site';
import { withBase } from '../utils/paths';

const current = Astro.url.pathname;
const homePath = withBase('/');
const resourcesPath = withBase('/resources/');
const isHome = current === homePath;
const isResources = current.startsWith(resourcesPath);
---

<header class:list={['site-header', { 'over-hero': isHome }]} data-header>
  <div class="header-inner">
    <a class="brand" href={homePath} aria-label="RCCG Victory House Wichita home">
      <span class="brand-mark" aria-hidden="true">
        <Image class="brand-logo" src={churchLogo} alt="" width={132} height={100} />
      </span>
      <span class="sr-only">RCCG Victory House Wichita</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation" data-desktop-nav>
      <a class:list={{ active: isHome }} href={homePath}>Home</a>
      {mainNav.map((item) => (
        <a class:list={{ active: current.startsWith(item.href) }} href={item.href}>
          {item.label}
        </a>
      ))}
      <a class:list={{ active: isResources }} href={resourcesPath}>Resources</a>
      <span class="nav-tracer" aria-hidden="true"></span>
    </nav>

    <a class="visit-btn" href={withBase('/visit-us/')}>
      Plan a visit
      <Arrow />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only">Open menu</span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
    <nav aria-label="Mobile navigation">
      <a href={homePath}>Home</a>
      {mainNav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={withBase('/visit-us/')}>Plan a visit</a>
      <a href={resourcesPath}>Resources</a>
    </nav>
    <p>1701 S Sedgwick St<br />Wichita, KS 67213</p>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 94px;
    border-bottom: 1px solid rgba(23, 35, 46, 0.13);
    background: rgba(233, 223, 204, 0.96);
    box-shadow: none;
    backdrop-filter: blur(18px);
  }

  .site-header.over-hero {
    color: var(--white);
    border-bottom-color: rgba(255, 255, 255, 0.15);
    background: rgba(23, 35, 46, 0.97);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    width: min(100% - 64px, 1480px);
    height: 100%;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(180px, 1fr) auto auto;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    width: max-content;
    align-items: center;
    color: inherit;
  }

  .brand-mark {
    display: grid;
    width: 100px;
    height: 64px;
    padding: 4px 7px;
    overflow: hidden;
    place-items: center;
    border: 1px solid rgba(23, 35, 46, 0.08);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(8, 23, 37, 0.13);
    transition: transform 220ms cubic-bezier(.22, 1, .36, 1), box-shadow 220ms ease;
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px);
    box-shadow: 0 11px 28px rgba(8, 23, 37, 0.17);
  }

  .brand :global(.brand-logo) {
    width: 86px;
    height: auto;
  }

  .desktop-nav {
    --nav-left: 0px;
    --nav-width: 0px;
    display: flex;
    position: relative;
    align-items: center;
    gap: clamp(22px, 2.25vw, 36px);
    padding: 0 28px;
    color: var(--ink);
    border: 1px solid rgba(23, 35, 46, 0.14);
    border-radius: 999px;
    background: rgba(240, 232, 216, 0.58);
    box-shadow: inset 0 1px 0 rgba(255, 250, 240, 0.38);
    backdrop-filter: blur(14px);
  }

  .over-hero .desktop-nav {
    color: rgba(255, 254, 249, 0.84);
    border-color: rgba(255, 250, 240, 0.16);
    background: rgba(255, 250, 240, 0.055);
    box-shadow: inset 0 1px 0 rgba(255, 250, 240, 0.08);
  }

  .desktop-nav a {
    position: relative;
    display: inline-flex;
    z-index: 1;
    min-height: 46px;
    align-items: center;
    padding: 0;
    border-radius: 0;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    transition: color 180ms ease;
  }

  .desktop-nav a::after {
    display: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--forest);
  }

  .over-hero .desktop-nav a:hover,
  .over-hero .desktop-nav a.active {
    color: var(--gold);
  }

  .nav-tracer {
    position: absolute;
    bottom: 6px;
    left: 0;
    width: var(--nav-width);
    height: 2px;
    border-radius: 99px;
    background: var(--coral);
    opacity: 0;
    transform: translateX(var(--nav-left));
    transition: width 320ms cubic-bezier(.22, 1, .36, 1), transform 320ms cubic-bezier(.22, 1, .36, 1), opacity 180ms ease;
    pointer-events: none;
  }

  .desktop-nav.is-ready .nav-tracer {
    opacity: 1;
  }

  .over-hero .nav-tracer {
    background: var(--gold);
  }

  .visit-btn {
    display: inline-flex;
    justify-self: end;
    align-items: center;
    gap: 12px;
    min-height: 46px;
    padding: 0 18px 0 20px;
    border: 1px solid var(--forest-deep);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .visit-btn :global(svg) {
    width: 16px;
    transition: transform 180ms ease;
  }

  .visit-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  .visit-btn:hover {
    color: var(--white);
    background: var(--forest-deep);
    border-color: var(--forest-deep);
    transform: translateY(-1px);
  }

  .over-hero .visit-btn {
    border-color: rgba(255, 254, 249, 0.64);
  }

  .over-hero .visit-btn:hover {
    color: var(--forest-deep);
    border-color: var(--gold);
    background: var(--gold);
  }

  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 1050px) {
    .site-header,
    .site-header.over-hero {
      height: var(--header-h);
    }

    .header-inner {
      width: min(100% - 32px, 1440px);
      display: flex;
      justify-content: space-between;
    }

    .desktop-nav,
    .visit-btn {
      display: none;
    }

    .brand-mark {
      width: 84px;
      height: 52px;
      padding: 3px 5px;
      border-radius: 10px;
    }

    .brand :global(.brand-logo) {
      width: 74px;
    }

    .menu-toggle {
      display: grid;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 0;
      place-content: center;
      gap: 7px;
      color: inherit;
      background: transparent;
      cursor: pointer;
    }

    .menu-toggle span:not(.sr-only) {
      width: 24px;
      height: 1.5px;
      background: currentColor;
      transition: transform 180ms ease;
    }

    .menu-toggle[aria-expanded='true'] span:nth-of-type(1) {
      transform: translateY(4px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] span:nth-of-type(2) {
      transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-menu {
      position: fixed;
      inset: var(--header-h) 0 auto;
      z-index: 99;
      width: 100%;
      height: calc(100svh - var(--header-h));
      display: flex;
      padding: 34px 24px 40px;
      color: var(--white);
      background: var(--forest-deep);
      flex-direction: column;
      justify-content: space-between;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-10px);
      overflow-y: auto;
      transition: opacity 220ms ease, transform 220ms ease;
    }

    .mobile-menu.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .mobile-menu nav {
      display: flex;
      flex-direction: column;
    }

    .mobile-menu nav a {
      padding: 5px 0;
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 7.5vw, 2.6rem) !important;
      font-weight: 600;
      letter-spacing: -0.035em !important;
      line-height: 1.12 !important;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 360ms cubic-bezier(.22, 1, .36, 1), transform 360ms cubic-bezier(.22, 1, .36, 1);
    }

    .mobile-menu.is-open nav a {
      opacity: 1;
      transform: translateY(0);
    }

    .mobile-menu.is-open nav a:nth-child(2) { transition-delay: 35ms; }
    .mobile-menu.is-open nav a:nth-child(3) { transition-delay: 70ms; }
    .mobile-menu.is-open nav a:nth-child(4) { transition-delay: 105ms; }
    .mobile-menu.is-open nav a:nth-child(5) { transition-delay: 140ms; }
    .mobile-menu.is-open nav a:nth-child(6) { transition-delay: 175ms; }
    .mobile-menu.is-open nav a:nth-child(7) { transition-delay: 210ms; }
    .mobile-menu.is-open nav a:nth-child(8) { transition-delay: 245ms; }

    .mobile-menu p {
      margin: 0;
      font-size: 0.84rem;
      opacity: 0.7;
    }

    .site-header.has-open-menu,
    .site-header.over-hero.has-open-menu {
      position: fixed;
      inset: 0 0 auto;
      color: var(--white);
      background: var(--forest-deep);
      border-color: rgba(255, 255, 255, 0.15);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-desktop-nav]');
  const links = Array.from(nav?.querySelectorAll<HTMLAnchorElement>('a') ?? []);

  const moveTracer = (link: HTMLAnchorElement | undefined) => {
    if (!nav || !link) return;
    nav.style.setProperty('--nav-left', `${link.offsetLeft}px`);
    nav.style.setProperty('--nav-width', `${link.offsetWidth}px`);
    nav.classList.add('is-ready');
  };

  const activeLink = links.find((link) => link.classList.contains('active')) ?? links[0];
  const resetTracer = () => moveTracer(activeLink);

  links.forEach((link) => link.addEventListener('pointerenter', () => moveTracer(link)));
  nav?.addEventListener('pointerleave', resetTracer);
  window.addEventListener('resize', resetTracer);
  requestAnimationFrame(resetTracer);
</script>
