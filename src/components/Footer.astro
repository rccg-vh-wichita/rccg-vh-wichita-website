---
import Arrow from './Arrow.astro';
import { Image } from 'astro:assets';
import churchLogo from '../assets/images/victory-house-logo.png';
import { church, mainNav } from '../data/site';
import { withBase } from '../utils/paths';
---

<footer class="footer">
  <div class="wrap footer-top">
    <div class="footer-brand">
      <a class="footer-logo" href={withBase('/')}>
        <Image src={churchLogo} alt="RCCG Victory House Wichita" width={264} height={200} />
      </a>
      <p>{church.mission}</p>
    </div>

    <div class="footer-column">
      <p class="footer-label">Explore</p>
      {mainNav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={withBase('/gallery-4/')}>Gallery</a>
      <a href={withBase('/resources/')}>Resources</a>
    </div>

    <div class="footer-column">
      <p class="footer-label">Visit</p>
      <a href={church.mapUrl} target="_blank" rel="noreferrer">
        1701 S Sedgwick St<br />Wichita, KS 67213
      </a>
      <a href={`tel:+13162672673`}>{church.phone}</a>
      <a href={`mailto:${church.email}`}>{church.email}</a>
    </div>

    <div class="footer-column social">
      <p class="footer-label">Follow</p>
      <a href={church.youtube} target="_blank" rel="noreferrer">YouTube <Arrow /></a>
      <a href={church.instagram} target="_blank" rel="noreferrer">Instagram <Arrow /></a>
      <a href={church.facebook} target="_blank" rel="noreferrer">Facebook <Arrow /></a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>© {new Date().getFullYear()} RCCG Victory House Wichita</p>
    <p>A parish of the Redeemed Christian Church of God</p>
  </div>
</footer>

<style>
  .footer {
    padding: 76px 0 24px;
    color: rgba(255, 254, 249, 0.82);
    background: var(--forest-deep);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 48px;
  }

  .footer-logo {
    display: grid;
    width: 170px;
    min-height: 116px;
    padding: 7px 10px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 14px 34px rgba(4, 15, 24, 0.24);
    transition: transform 220ms cubic-bezier(.22, 1, .36, 1), box-shadow 220ms ease;
  }

  .footer-logo:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(4, 15, 24, 0.3);
  }

  .footer-logo :global(img) {
    width: 150px;
    height: auto;
  }

  .footer-brand > p {
    max-width: 270px;
    margin: 28px 0 0;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.86rem;
  }

  .footer-column a {
    transition: color 160ms ease;
  }

  .footer-column a:hover {
    color: var(--white);
  }

  .footer-label {
    margin: 0 0 10px;
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .social :global(svg) {
    width: 14px;
  }

  .footer-bottom {
    display: flex;
    margin-top: 76px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    justify-content: space-between;
    gap: 24px;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    opacity: 0.55;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .footer {
      padding-top: 56px;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .footer-bottom {
      margin-top: 54px;
      flex-direction: column;
    }
  }
</style>
