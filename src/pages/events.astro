---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import VisitCTA from '../components/VisitCTA.astro';
import Arrow from '../components/Arrow.astro';
import choir from '../assets/images/choir.jpg';
import worshipperSinging from '../assets/images/woman-singing-worship.png';
import { church, recurringEvents, monthlyServices } from '../data/site';
---

<BaseLayout
  title="Events | RCCG Victory House Wichita"
  description="Worship gatherings, family events, prayer nights, and community outreach at Victory House Wichita."
>
  <PageHero
    eyebrow="Events"
    title="What is happening at Victory House"
    intro="We are a vibrant church with events throughout the year. We involve our ministries and make community outreach an important part of what we do."
    image={choir}
    imageAlt="Victory House worship team singing together"
    layout="poster"
  />

  <section class="updates section-sm">
    <div class="wrap updates-inner reveal">
      <div>
        <p class="eyebrow">Current information</p>
        <h2 class="heading">See our latest event announcements.</h2>
      </div>
      <p>
        Special-event schedules change throughout the year. For the most current details,
        follow Victory House on Instagram and Facebook, or contact the church office.
      </p>
      <div class="updates-actions">
        <a class="btn btn-primary" href={church.instagram} target="_blank" rel="noreferrer">Instagram <Arrow /></a>
        <a class="btn btn-outline" href={church.facebook} target="_blank" rel="noreferrer">Facebook <Arrow /></a>
        <a class="text-link" href={`mailto:${church.email}`}>Contact us</a>
      </div>
    </div>
  </section>

  <section class="signature section">
    <div class="wrap">
      <div class="section-heading reveal">
        <p class="eyebrow">Throughout the year</p>
        <h2 class="title">Events for worship, family, and our community.</h2>
      </div>
      <ol class="event-list">
        {recurringEvents.map((event, index) => (
          <li class="event reveal">
            <div class="event-number">{String(index + 1).padStart(2, '0')}</div>
            <div class="event-title">
              <span>{event.type}</span>
              <h3>{event.name}</h3>
            </div>
            <p>{event.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="monthly section">
    <div class="wrap monthly-grid">
      <div class="monthly-media reveal">
        <Image src={worshipperSinging} alt="A Victory House member singing during worship" width={1200} widths={[640, 900, 1200]} sizes="(max-width: 800px) 100vw, 50vw" />
      </div>
      <div class="monthly-copy reveal">
        <p class="eyebrow">Every month</p>
        <h2 class="title">Our regular monthly services.</h2>
        <ul>
          {monthlyServices.map((service) => (
            <li>
              <h3>{service.name}</h3>
              <p>{service.cadence}</p>
              <strong>{service.time}</strong>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <VisitCTA />
</BaseLayout>

<style>
  .updates {
    background: var(--peach);
  }

  .updates-inner {
    display: grid;
    grid-template-columns: 1fr 0.7fr auto;
    align-items: end;
    gap: clamp(34px, 7vw, 90px);
  }

  .updates-inner > p {
    margin: 0;
    color: rgba(32, 37, 43, 0.68);
  }

  .updates-actions {
    display: flex;
    width: 182px;
    min-width: 0;
    align-items: stretch;
    flex-direction: column;
    gap: 12px;
    justify-self: start;
  }

  .updates-actions .btn {
    width: 100%;
    justify-content: space-between;
  }

  .updates-actions .text-link {
    align-self: center;
    margin-top: 4px;
    text-align: center;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    align-items: start;
    gap: 40px;
    margin-bottom: 70px;
  }

  .event-list {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
  }

  .event {
    position: relative;
    min-height: 320px;
    display: flex;
    padding: clamp(30px, 4vw, 52px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    flex-direction: column;
    justify-content: space-between;
    transition: transform 220ms ease, color 220ms ease, background 220ms ease;
  }

  .event:first-child {
    min-height: 390px;
    grid-column: 1 / -1;
    color: var(--forest-deep);
    background: var(--gold);
  }

  .event:nth-child(3),
  .event:nth-child(6) {
    background: var(--aqua-wash);
  }

  .event:nth-child(4) {
    background: var(--sunwash);
  }

  .event:hover {
    z-index: 1;
    color: var(--white);
    background: var(--forest);
    transform: translateY(-5px);
  }

  .event-number {
    padding: 0;
    color: var(--coral);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .event-title > span {
    color: var(--forest);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .event-title h3 {
    margin: 5px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .event > p {
    max-width: 430px;
    margin: 24px 0 0;
    color: rgba(32, 37, 43, 0.64);
    font-size: 0.88rem;
  }

  .event:first-child .event-title h3 {
    max-width: 850px;
    font-size: clamp(3.2rem, 6vw, 6.5rem);
  }

  .event:hover .event-number,
  .event:hover .event-title > span,
  .event:hover > p {
    color: inherit;
  }

  .monthly {
    color: var(--white);
    background: var(--forest-deep);
  }

  .monthly-grid {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    align-items: center;
    gap: clamp(54px, 9vw, 130px);
  }

  .monthly-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .monthly-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .monthly .eyebrow {
    color: var(--gold);
  }

  .monthly ul {
    margin: 50px 0 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    list-style: none;
  }

  .monthly li {
    position: relative;
    padding: 24px 90px 24px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .monthly li h3,
  .monthly li p {
    margin: 0;
  }

  .monthly li h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .monthly li p {
    margin-top: 4px;
    font-size: 0.75rem;
    opacity: 0.56;
  }

  .monthly li strong {
    position: absolute;
    top: 29px;
    right: 0;
    color: var(--gold);
    font-size: 0.74rem;
  }

  @media (max-width: 850px) {
    .updates-inner,
    .section-heading,
    .monthly-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .event-list {
      grid-template-columns: 1fr;
    }

    .event:first-child {
      grid-column: auto;
    }

    .updates-inner {
      gap: 24px;
    }

    .updates-actions {
      width: min(228px, 100%);
      margin-top: 2px;
      justify-self: center;
    }
  }

  @media (max-width: 1100px) and (min-width: 851px) {
    .updates-inner {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
      column-gap: clamp(44px, 6vw, 72px);
      row-gap: 22px;
    }

    .updates-actions {
      grid-column: 2;
      width: 228px;
      justify-self: center;
    }
  }

  @media (max-width: 520px) {

    .monthly li {
      padding-right: 0;
    }

    .monthly li strong {
      position: static;
      display: block;
      margin-top: 8px;
    }
  }
</style>
