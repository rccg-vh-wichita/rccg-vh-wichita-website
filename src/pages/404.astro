---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Page Not Found | RCCG Victory House Wichita"
  description="The page you were looking for could not be found."
>
  <section class="not-found">
    <div class="wrap">
      <p class="eyebrow">404 · Page not found</p>
      <h1 class="display">We could not find that page.</h1>
      <p>It may have moved while we were rebuilding the website.</p>
      <div>
        <a class="btn btn-light" href={withBase('/')}>Return home <Arrow /></a>
        <a class="text-link" href={withBase('/visit-us/')}>Plan a visit</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 76vh;
    display: flex;
    align-items: center;
    padding: 100px 0;
    color: var(--white);
    background: var(--forest-deep);
  }

  .not-found .eyebrow {
    color: var(--gold);
  }

  .not-found > .wrap > p:not(.eyebrow) {
    margin: 30px 0;
    opacity: 0.68;
  }

  .not-found > .wrap > div {
    display: flex;
    align-items: center;
    gap: 24px;
  }
</style>
