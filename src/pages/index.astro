---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import VisitCTA from '../components/VisitCTA.astro';
import { withBase } from '../utils/paths';
import heroWorshipMoment from '../assets/images/hero-worship-musicians-hires.jpg';
import heroWorshipTeam from '../assets/images/worship-team-color.jpg';
import heroKeyboard from '../assets/images/keyboard-worship-blue.jpg';
import pastorSamWorship from '../assets/images/pastor-sam-worship.jpg';
import lifeWorship from '../assets/images/prayer.jpg';
import lifePortrait from '../assets/images/worship-portrait-monochrome.jpg';
import lifePrayer from '../assets/images/congregation-hands-monochrome.jpg';
import guestPreacher from '../assets/images/guest-preacher-navy.jpg';
import womanPraying from '../assets/images/woman-praying-monochrome.jpg';
import connectedMinistries from '../assets/images/choir.jpg';
import connectedEvents from '../assets/images/congregation-cultural-worship.jpg';
import prayerMinistry from '../assets/images/prayer-ministry.jpg';
import { church, services } from '../data/site';
---

<BaseLayout
  title="RCCG Victory House Wichita | Church in Wichita, KS"
  description="Welcome to RCCG Victory House Wichita, a Redeemed Christian Church of God parish. Join us for Sunday worship at 10:00 AM in Wichita, Kansas."
  imageAlt="Worship at RCCG Victory House Wichita"
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Redeemed Christian Church of God</p>
      <h1>RCCG Victory House Wichita</h1>
      <p class="hero-intro">
        A church family learning God’s Word, worshipping together, and encouraging one another through every season of life.
      </p>
      <div class="hero-actions">
        <a class="btn btn-dark" href={withBase('/visit-us/')}>Plan your visit <Arrow /></a>
        <a class="quiet-link" href={church.youtube} target="_blank" rel="noreferrer">Watch online <Arrow /></a>
      </div>
    </div>

    <div class="hero-collage" data-hero-collage>
      <figure class="hero-media hero-media-main" data-depth="0.012">
        <Image
          src={heroWorshipMoment}
          alt="Victory House worshippers and musicians during a service"
          width={2400}
          widths={[900, 1440, 2000, 2400]}
          sizes="(max-width: 840px) 100vw, 48vw"
          loading="eager"
        />
        <figcaption>
          <span>Wichita, Kansas</span>
          <strong>Equipping brethren to be the best.</strong>
        </figcaption>
      </figure>
      <figure class="hero-media hero-media-detail hero-media-detail-top" data-depth="-0.018">
        <Image src={heroWorshipTeam} alt="The Victory House worship team" width={1200} widths={[480, 720, 1000, 1200]} sizes="18vw" loading="eager" />
      </figure>
      <figure class="hero-media hero-media-detail hero-media-detail-bottom" data-depth="0.022">
        <Image src={heroKeyboard} alt="A musician serving during worship at Victory House" width={1200} widths={[480, 720, 1000, 1200]} sizes="18vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="service-note" data-service-note aria-label="Sunday worship at 10:00 AM, 1701 South Sedgwick Street, Wichita, Kansas">
    <div class="wrap service-note-inner">
      <div class="service-note-title">
        <span>Every Sunday</span>
        <strong>Worship at Victory House</strong>
      </div>
      <time class="service-note-time" datetime="10:00">
        <strong>10:00</strong>
        <span>AM</span>
      </time>
      <address class="service-note-address">
        <strong>1701 S Sedgwick St</strong>
        <span>Wichita, Kansas</span>
      </address>
      <a class="service-note-link" href="https://maps.google.com/?q=1701+S+Sedgwick+St+Wichita+KS" target="_blank" rel="noreferrer">
        Get directions <Arrow />
      </a>
    </div>
  </section>

  <section class="welcome-statement section">
    <div class="wrap statement-grid">
      <p class="eyebrow reveal">Welcome to Victory House</p>
      <div class="statement-copy reveal">
        <h2>Equipping brethren to be the best.</h2>
        <p>
          We are a parish of the Redeemed Christian Church of God, made up of people from different backgrounds and generations, all united by faith in Jesus Christ.
        </p>
      </div>
      <div class="statement-invite reveal">
        <p>If you are looking for a church in Wichita, we would be glad to meet you.</p>
        <a class="text-link" href={withBase('/about-us/')}>Our story <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="services-feature">
    <figure class="services-photo reveal">
      <Image
        src={pastorSamWorship}
        alt="Pastor Sam Kayode worshipping at RCCG Victory House Wichita"
        width={1440}
        widths={[720, 1000, 1440]}
        sizes="(max-width: 840px) 100vw, 50vw"
      />
    </figure>
    <div class="services-copy">
      <p class="eyebrow reveal">Come worship with us</p>
      <h2 class="reveal">Join us for worship.</h2>
      <div class="service-list">
        {services.map((service) => (
          <article class="service-row reveal">
            <div>
              <p>{service.cadence}</p>
              <h3>{service.name}</h3>
              <small>{service.note}</small>
            </div>
            <strong>{service.time}</strong>
          </article>
        ))}
      </div>
      <a class="btn btn-dark reveal" href={withBase('/visit-us/')}>What to expect <Arrow /></a>
    </div>
  </section>

  <section class="church-life section">
    <div class="wrap life-heading reveal">
      <div>
        <p class="eyebrow">Life at Victory House</p>
        <h2>Life at Victory House.</h2>
      </div>
      <p>Photos from Sunday services and other gatherings at Victory House.</p>
    </div>
    <div class="life-gallery-field">
      <div class="wrap life-gallery">
        <figure class="life-item life-item-wide reveal" data-depth="0.018">
          <div class="life-image">
            <Image src={lifeWorship} alt="Victory House members worshipping together" width={2200} widths={[900, 1400, 1800, 2200]} sizes="50vw" />
          </div>
          <figcaption><strong>Worship together</strong><span>Victory House Wichita</span></figcaption>
        </figure>
        <figure class="life-item reveal" data-depth="-0.026">
          <div class="life-image">
            <Image src={lifePortrait} alt="A Victory House member in prayer" width={1400} widths={[600, 900, 1200, 1400]} sizes="25vw" />
          </div>
          <figcaption><strong>Sunday worship</strong><span>Victory House Wichita</span></figcaption>
        </figure>
        <figure class="life-item reveal" data-depth="0.038">
          <div class="life-image">
            <Image src={lifePrayer} alt="Victory House members praying together" width={1400} widths={[600, 900, 1200, 1400]} sizes="25vw" />
          </div>
          <figcaption><strong>Prayer together</strong><span>Victory House Wichita</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="vision">
    <div class="wrap vision-grid">
      <div class="vision-copy reveal">
        <p class="eyebrow">The vision of our church</p>
        <blockquote>
          “To build, empower and disciple the saved through the powerful Word of God, and to reach the unsaved through evangelism and missions.”
        </blockquote>
        <a class="quiet-link light" href={withBase('/about-us/')}>Read our story <Arrow /></a>
        <p class="vision-since">RCCG Victory House Wichita <span aria-hidden="true">·</span> Serving Wichita since 2003</p>
      </div>
      <figure class="vision-photo reveal">
        <div class="vision-image">
          <Image src={guestPreacher} alt="A guest preacher sharing at Victory House Wichita" width={1800} widths={[720, 1100, 1500, 1800]} sizes="(max-width: 840px) 100vw, 42vw" />
        </div>
      </figure>
    </div>
  </section>

  <section class="pathways section">
    <div class="wrap pathways-heading reveal">
      <p class="eyebrow">Find your place</p>
      <h2>Get connected at Victory House.</h2>
    </div>
    <div class="wrap pathway-grid">
      <a class="pathway pathway-featured reveal" href={withBase('/our-ministries/')}>
        <Image src={connectedMinistries} alt="The Victory House praise team worshipping together" width={1800} widths={[720, 1100, 1500, 1800]} sizes="(max-width: 840px) 100vw, 52vw" />
        <div><span>01</span><h3>Ministries</h3><p>Grow, serve, and build lasting relationships.</p><Arrow /></div>
      </a>
      <a class="pathway pathway-events pathway-monochrome reveal" href={withBase('/events/')}>
        <Image src={connectedEvents} alt="Victory House members worshipping together during a church gathering" width={1400} widths={[600, 900, 1200, 1400]} sizes="(max-width: 840px) 50vw, 45vw" />
        <div><span>02</span><h3>Events</h3><p>Gatherings, prayer meetings, and church celebrations.</p><Arrow /></div>
      </a>
      <a class="pathway pathway-outreach reveal" href={withBase('/donate/')}>
        <Image src={prayerMinistry} alt="Victory House members praying together" width={1000} widths={[520, 760, 1000]} sizes="(max-width: 840px) 50vw, 45vw" />
        <div><span>03</span><h3>Community outreach</h3><p>Practical help and care for families in Wichita.</p><Arrow /></div>
      </a>
    </div>
  </section>

  <section class="watch-feature">
    <figure class="watch-photo reveal">
      <Image src={womanPraying} alt="A Victory House member in prayer" width={1500} widths={[720, 1100, 1500]} sizes="(max-width: 840px) 100vw, 52vw" />
    </figure>
    <div class="watch-copy reveal">
      <p class="eyebrow">Watch & worship</p>
      <h2>Watch our services and sermons.</h2>
      <p>Watch sermons, worship, and messages of hope from RCCG Victory House Wichita.</p>
      <a class="btn btn-dark" href={withBase('/sermons/')}>Watch now <Arrow /></a>
    </div>
  </section>

  <section class="generosity section">
    <div class="wrap generosity-grid">
      <p class="verse reveal">2 Corinthians 9:7</p>
      <h2 class="reveal">“God loves a cheerful giver.”</h2>
      <div class="generosity-copy reveal">
        <p>Your giving supports our ministries, missions, and community outreach.</p>
        <a class="text-link" href={withBase('/donate/')}>Ways to give <Arrow /></a>
      </div>
    </div>
  </section>

  <VisitCTA />
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const depthItems = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
  const serviceNote = document.querySelector<HTMLElement>('[data-service-note]');
  let scheduled = false;

  if (serviceNote) {
    serviceNote.classList.add('service-note-ready');

    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      serviceNote.classList.add('is-visible');
    } else {
      const serviceObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        serviceNote.classList.add('is-visible');
        observer.disconnect();
      }, { threshold: .42 });

      serviceObserver.observe(serviceNote);
    }
  }

  const updateDepth = () => {
    scheduled = false;
    if (reduceMotion.matches) return;
    const viewportCenter = window.innerHeight / 2;
    depthItems.forEach((item) => {
      const rect = item.getBoundingClientRect();
      const depth = Number(item.dataset.depth ?? 0);
      const offset = Math.max(-34, Math.min(34, (rect.top + rect.height / 2 - viewportCenter) * depth));
      item.style.setProperty('--depth-y', `${offset}px`);
    });
  };

  const scheduleDepth = () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateDepth);
  };

  updateDepth();
  window.addEventListener('scroll', scheduleDepth, { passive: true });
  window.addEventListener('resize', scheduleDepth);
</script>

<style>
  .home-hero {
    position: relative;
    min-height: calc(100svh - 148px);
    overflow: hidden;
    color: var(--white);
    background: var(--forest-deep);
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    width: min(59%, 900px);
    min-height: calc(100svh - 148px);
    display: flex;
    padding: clamp(72px, 8vw, 124px) 40px clamp(70px, 7vw, 110px) max(32px, calc((100vw - 1480px) / 2 + 28px));
    flex-direction: column;
    justify-content: center;
  }

  .hero-copy::after {
    position: absolute;
    right: 10%;
    bottom: 10%;
    width: 84px;
    height: 1px;
    background: var(--gold);
    content: '';
    transform: rotate(-48deg);
    transform-origin: right center;
    opacity: .9;
  }

  .hero-copy .eyebrow {
    margin-bottom: 30px;
    color: var(--gold);
    animation: hero-rise 800ms 100ms both cubic-bezier(.22, 1, .36, 1);
  }

  h1 {
    max-width: 820px;
    margin: 0;
    color: var(--white);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 7vw, 8.5rem);
    font-weight: 600;
    letter-spacing: -.068em;
    line-height: .84;
    text-wrap: balance;
    animation: hero-rise 900ms 180ms both cubic-bezier(.22, 1, .36, 1);
  }

  .hero-intro {
    max-width: 555px;
    margin: 34px 0 0;
    color: rgba(255, 254, 249, .72);
    font-size: clamp(1rem, 1.25vw, 1.17rem);
    line-height: 1.65;
    animation: hero-rise 900ms 270ms both cubic-bezier(.22, 1, .36, 1);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 34px;
    animation: hero-rise 900ms 350ms both cubic-bezier(.22, 1, .36, 1);
  }

  .home-hero .btn-dark {
    color: var(--forest-deep);
    background: var(--gold);
  }

  .home-hero .btn-dark:hover { background: var(--white); }

  .services-copy .btn-dark,
  .watch-copy .btn-dark { color: var(--white); background: var(--forest-deep); }

  .quiet-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid currentColor;
    font-size: .76rem;
    font-weight: 750;
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .home-hero .quiet-link { color: var(--white); }
  .quiet-link :global(svg) { width: 16px; }
  .quiet-link.light { color: var(--white); }

  .hero-collage {
    position: absolute;
    inset: clamp(24px, 3vw, 48px) clamp(22px, 3vw, 50px) clamp(24px, 3vw, 48px) 39%;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(150px, 15vw, 250px);
    grid-template-rows: 1fr 1fr;
    gap: clamp(8px, .8vw, 14px);
    overflow: hidden;
    background: var(--forest-deep);
    clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
    pointer-events: none;
    animation: image-reveal 1100ms 80ms both cubic-bezier(.22, 1, .36, 1);
  }

  .hero-media {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--forest-deep);
    transform: translateY(var(--depth-y, 0));
    transition: transform 160ms linear;
  }

  .hero-media-main { grid-row: 1 / -1; }

  .hero-media-detail {
    opacity: .94;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% center;
    filter: saturate(.98) contrast(1.04);
    transform: scale(1.025);
    animation: hero-image-settle 1400ms 100ms both cubic-bezier(.22, 1, .36, 1);
  }

  .hero-media-detail :global(img) {
    object-position: center;
    transform: scale(1.02);
  }

  .hero-media-detail-top :global(img) { object-position: 48% center; }
  .hero-media-detail-bottom :global(img) { object-position: 54% center; }

  .hero-collage--overlay {
    display: block;
  }

  .hero-collage--overlay .hero-media-main {
    position: absolute;
    inset: 0;
  }

  .hero-collage--overlay .hero-media-detail {
    position: absolute;
    z-index: 3;
    border: clamp(6px, .55vw, 9px) solid var(--navy);
    box-shadow: 0 20px 48px rgba(5, 13, 19, .24);
  }

  .hero-collage--overlay .hero-media-detail-top {
    top: clamp(10px, 3.8vw, 58px);
    right: clamp(2px, .6vw, 10px);
    width: clamp(164px, 15.5vw, 230px);
    aspect-ratio: .76;
  }

  .hero-collage--overlay .hero-media-detail-bottom {
    bottom: clamp(44px, 6.6vw, 92px);
    left: 31%;
    width: clamp(146px, 12.5vw, 188px);
    aspect-ratio: .74;
  }

  .hero-collage--overlay .hero-media-detail-top :global(img) { object-position: 58% center; }
  .hero-collage--overlay .hero-media-detail-bottom :global(img) { object-position: 48% center; }

  .hero-collage--mosaic {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1.2fr) minmax(250px, .8fr);
  }

  .hero-collage--mosaic .hero-media-main {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .hero-collage--mosaic .hero-media-detail-top {
    grid-column: 1;
    grid-row: 2;
    animation: mosaic-tile-reveal 850ms 430ms both cubic-bezier(.22, 1, .36, 1);
  }

  .hero-collage--mosaic .hero-media-detail-bottom {
    grid-column: 2;
    grid-row: 2;
    animation: mosaic-tile-reveal 850ms 560ms both cubic-bezier(.22, 1, .36, 1);
  }

  .hero-collage--mosaic .hero-media-main :global(img) { object-position: 50% 8%; }
  .hero-collage--mosaic .hero-media-detail-top :global(img) { object-position: 50% 18%; }
  .hero-collage--mosaic .hero-media-detail-bottom :global(img) { object-position: 50% 22%; }

  .hero-media-main::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(23, 35, 46, .98) 0%, rgba(23, 35, 46, .66) 25%, transparent 55%),
      linear-gradient(to top, rgba(14, 24, 34, .7), transparent 48%);
    content: '';
  }

  .hero-media figcaption { position: absolute; right: 28px; bottom: 26px; left: 16%; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; color: var(--white); }
  .hero-media figcaption span { font-size: .65rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .hero-media figcaption strong { max-width: 340px; font-family: var(--font-display); font-size: 1.45rem; font-weight: 600; text-align: right; }

  .service-note {
    position: relative;
    overflow: hidden;
    color: var(--white);
    background: #24323e;
  }

  .service-note::after {
    position: absolute;
    inset: 3px auto 0 -26%;
    z-index: 0;
    width: 28%;
    background: linear-gradient(100deg, transparent, rgba(229, 158, 46, .12), rgba(255, 247, 235, .06), transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: skewX(-16deg);
  }

  .service-note::before {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--gold), var(--coral));
    content: '';
    transform-origin: left;
    transform: scaleX(1);
  }

  .service-note-ready::before { transform: scaleX(0); }
  .service-note-ready.is-visible::before { animation: service-line 1150ms 90ms both cubic-bezier(.22, 1, .36, 1); }
  .service-note-ready.is-visible::after { animation: service-light-pass 1350ms 180ms both cubic-bezier(.22, 1, .36, 1); }

  .service-note-inner {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 122px;
    grid-template-columns: 1.2fr .55fr 1fr auto;
    align-items: center;
    gap: 0;
  }

  .service-note-title,
  .service-note-time,
  .service-note-address,
  .service-note-link {
    min-width: 0;
    opacity: 1;
    transform: translateY(0);
  }

  .service-note-ready .service-note-title,
  .service-note-ready .service-note-time,
  .service-note-ready .service-note-address,
  .service-note-ready .service-note-link { opacity: 0; transform: translateY(18px); }
  .service-note-ready.is-visible .service-note-title { animation: service-rise 680ms 250ms both cubic-bezier(.22, 1, .36, 1); }
  .service-note-ready.is-visible .service-note-time { animation: service-time-rise 780ms 350ms both cubic-bezier(.22, 1, .36, 1); }
  .service-note-ready.is-visible .service-note-address { animation: service-rise 680ms 460ms both cubic-bezier(.22, 1, .36, 1); }
  .service-note-ready.is-visible .service-note-link { animation: service-rise 680ms 570ms both cubic-bezier(.22, 1, .36, 1); }

  .service-note-title,
  .service-note-time,
  .service-note-address {
    display: flex;
    min-height: 58px;
    padding: 0 clamp(22px, 3vw, 46px);
    border-right: 1px solid rgba(255, 247, 235, .16);
    flex-direction: column;
    justify-content: center;
  }

  .service-note-title { padding-left: 0; }

  .service-note-title span,
  .service-note-address span,
  .service-note-time span {
    color: rgba(255, 247, 235, .6);
    font-size: .62rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .service-note-title strong,
  .service-note-address strong { margin-top: 5px; font-size: .9rem; }
  .service-note-address { margin: 0; }
  .service-note-time { flex-direction: row; align-items: baseline; gap: 8px; }
  .service-note-time strong { color: var(--gold); font-family: var(--font-display); font-size: clamp(2.3rem, 3.3vw, 3.7rem); font-weight: 600; letter-spacing: -.04em; line-height: 1; }
  .service-note-link { display: inline-flex; margin-left: clamp(22px, 3vw, 44px); align-items: center; gap: 12px; color: var(--white); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .service-note-link :global(svg) { width: 18px; transition: transform 240ms ease; }
  .service-note-link:hover :global(svg) { transform: translateX(6px); }

  .welcome-statement {
    position: relative;
    overflow: hidden;
    background: linear-gradient(104deg, var(--gold) 0 76%, var(--peach) 76%);
  }

  .welcome-statement::before {
    position: absolute;
    right: -1.5vw;
    bottom: -8.5vw;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(8rem, 21vw, 24rem);
    font-weight: 600;
    letter-spacing: -.08em;
    line-height: 1;
    content: 'WELCOME';
    -webkit-text-stroke: 1px rgba(23, 35, 46, .17);
    pointer-events: none;
  }

  .statement-grid { position: relative; z-index: 1; display: grid; grid-template-columns: .38fr 1fr .55fr; align-items: start; gap: clamp(34px, 6vw, 96px); }
  .welcome-statement .eyebrow { color: var(--forest-deep); }
  .statement-copy h2 { max-width: 760px; margin: 0; font-family: var(--font-display); font-size: clamp(3.2rem, 5.7vw, 6.2rem); font-weight: 600; letter-spacing: -.06em; line-height: .92; }
  .statement-copy p, .statement-invite p { color: rgba(23, 35, 46, .8); }
  .statement-copy p { max-width: 680px; margin: 28px 0 0; }
