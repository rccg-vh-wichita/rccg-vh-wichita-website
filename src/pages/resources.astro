---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitCTA from '../components/VisitCTA.astro';
import Arrow from '../components/Arrow.astro';
import { resources } from '../data/site';
---

<BaseLayout
  title="Resources | RCCG Victory House Wichita"
  description="Devotionals, Bible study resources, and spiritual growth tools from Victory House Wichita."
>
  <section class="resources-hero">
    <div class="resources-hero-mark" aria-hidden="true"></div>
    <div class="wrap resources-hero-inner">
      <p class="eyebrow">Christian resources</p>
      <h1>Resources for the week</h1>
      <p>Devotionals and study materials to help you read Scripture, pray, and keep growing.</p>
    </div>
  </section>

  <section class="resources-directory section-sm">
    <div class="wrap directory-layout">
      <header class="directory-heading reveal">
        <p class="eyebrow">Helpful links</p>
        <h2>Devotionals and<br />study materials.</h2>
      </header>

      <ol class="resource-list">
        {resources.map((resource, index) => (
          <li class="resource reveal">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{resource.name}</h3>
              <p>{resource.description}</p>
            </div>
            <a href={resource.href} target="_blank" rel="noreferrer" aria-label={`Open ${resource.name}`}>
              <Arrow />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="rhythm section-sm">
    <div class="wrap rhythm-inner reveal">
      <p class="eyebrow">Daily time with God</p>
      <h2>Start with Scripture and prayer.</h2>
    </div>
  </section>

  <VisitCTA />
</BaseLayout>

<style>
  .resources-hero {
    position: relative;
    min-height: clamp(410px, 53vh, 520px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: var(--white);
    background: var(--forest-deep);
  }

  .resources-hero::before {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 78% 20%, rgba(227, 163, 75, 0.13), transparent 28%);
    content: '';
  }

  .resources-hero-mark {
    position: absolute;
    right: 10%;
    bottom: -20%;
    width: min(31vw, 370px);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    box-shadow: 0 0 0 62px rgba(227, 163, 75, 0.045), 0 0 0 124px rgba(255, 255, 255, 0.025);
  }

  .resources-hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 140px;
    padding-bottom: clamp(52px, 7vw, 78px);
    animation: hero-rise 650ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .resources-hero .eyebrow,
  .rhythm .eyebrow {
    color: var(--gold);
  }

  .resources-hero h1 {
    max-width: 820px;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.7rem, 6.8vw, 6.7rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .resources-hero-inner > p:last-child {
    max-width: 580px;
    margin: 22px 0 0;
    font-size: clamp(0.98rem, 1.45vw, 1.15rem);
    line-height: 1.55;
    opacity: 0.76;
  }

  .resources-directory {
    background: var(--cream);
  }

  .directory-layout {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(245px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(60px, 9vw, 135px);
  }

  .directory-heading h2,
  .rhythm h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .directory-heading h2 {
    font-size: clamp(2.6rem, 4.2vw, 4.5rem);
    line-height: 0.98;
  }

  .resource-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .resource {
    display: grid;
    align-items: center;
    padding: clamp(22px, 3vw, 32px) 0;
    border-bottom: 1px solid var(--line);
    grid-template-columns: 42px 1fr 44px;
    gap: 20px;
  }

  .resource > span {
    align-self: start;
    padding-top: 6px;
    color: var(--coral);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .resource h3,
  .resource p {
    margin: 0;
  }

  .resource h3 {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.6vw, 2.45rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .resource p {
    margin-top: 6px;
    color: rgba(32, 37, 43, 0.64);
    font-size: 0.86rem;
  }

  .resource > a {
    display: grid;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    place-content: center;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .resource > a:hover {
    color: var(--white);
    background: var(--forest-deep);
    transform: translateX(3px);
  }

  .resource :global(svg) {
    width: 17px;
  }

  .rhythm {
    color: var(--white);
    background: var(--forest-deep);
  }

  .rhythm-inner {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(180px, 0.4fr) minmax(0, 1fr);
    gap: clamp(40px, 8vw, 120px);
  }

  .rhythm h2 {
    max-width: 760px;
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    line-height: 0.98;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 800px) {
    .directory-layout,
    .rhythm-inner {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .resources-hero-mark {
      right: -18%;
      width: 68vw;
    }
  }

  @media (max-width: 520px) {
    .resources-hero {
      min-height: 470px;
    }

    .resources-hero-inner {
      padding-top: 125px;
      padding-bottom: 48px;
    }

    .resources-hero h1 {
      font-size: clamp(3.3rem, 15vw, 4.45rem);
    }

    .resource {
      grid-template-columns: 30px 1fr 38px;
      gap: 12px;
    }

    .resource > a {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resources-hero-inner {
      animation: none;
    }
  }
</style>
