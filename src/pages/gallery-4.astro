---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import VisitCTA from '../components/VisitCTA.astro';
import gathering from '../assets/images/gathering.jpg';
import choir from '../assets/images/choir.jpg';
import worship from '../assets/images/worship.jpg';
import prayer from '../assets/images/prayer.jpg';
import womanLeadingWorship from '../assets/images/woman-leading-worship-new.jpg';
import guestPreacher from '../assets/images/guest-preacher-navy.jpg';
import womanPraying from '../assets/images/woman-praying-monochrome.jpg';
import womanWorshipping from '../assets/images/woman-worshipping-maraca.jpg';
---

<BaseLayout
  title="Gallery | RCCG Victory House Wichita"
  description="A glimpse of worship, community, and life together at RCCG Victory House Wichita."
>
  <PageHero
    eyebrow="Gallery"
    title="Photos from our church family"
    intro="A look at worship, prayer, fellowship, and special moments at RCCG Victory House Wichita."
    dark={true}
  />

  <section class="gallery section">
    <div class="wrap gallery-intro reveal">
      <p class="eyebrow">Life at Victory House</p>
      <h2 class="title">Worship, fellowship, and time together</h2>
    </div>
    <div class="gallery-grid">
      <figure class="wide reveal">
        <Image src={choir} alt="Victory House choir leading a celebration" width={1800} widths={[720, 1200, 1800]} sizes="100vw" />
        <figcaption>Choir and praise</figcaption>
      </figure>
      <figure class="portrait reveal">
        <Image src={womanLeadingWorship} alt="A woman leading worship at Victory House" width={1000} widths={[480, 720, 1000]} sizes="48vw" />
        <figcaption>Leading worship</figcaption>
      </figure>
      <figure class="square reveal">
        <Image src={guestPreacher} alt="A guest preacher speaking at Victory House" width={1000} widths={[480, 720, 1000]} sizes="48vw" />
        <figcaption>Sharing the Word</figcaption>
      </figure>
      <figure class="full reveal">
        <Image src={gathering} alt="Friends sharing a joyful moment at Victory House" width={1800} widths={[720, 1200, 1800]} sizes="100vw" />
        <figcaption>Church fellowship</figcaption>
      </figure>
      <figure class="square reveal">
        <Image src={prayer} alt="Women worshipping at Victory House" width={1000} widths={[480, 720, 1000]} sizes="48vw" />
        <figcaption>Prayer and worship</figcaption>
      </figure>
      <figure class="portrait reveal">
        <Image src={womanWorshipping} alt="A woman worshipping during a Victory House service" width={1000} widths={[480, 720, 1000]} sizes="48vw" />
        <figcaption>Sunday worship</figcaption>
      </figure>
      <figure class="wide monochrome reveal">
        <Image src={womanPraying} alt="A Victory House member in prayer" width={1800} widths={[720, 1200, 1800]} sizes="100vw" />
        <figcaption>Time in prayer</figcaption>
      </figure>
      <figure class="full reveal">
        <Image src={worship} alt="The Victory House congregation praising together" width={1800} widths={[720, 1200, 1800]} sizes="100vw" />
        <figcaption>Worship together</figcaption>
      </figure>
    </div>
  </section>

  <VisitCTA />
</BaseLayout>

<style>
  .gallery-intro {
    margin-bottom: 80px;
  }

  .gallery-grid {
    width: min(1500px, calc(100% - 40px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 24px;
  }

  figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    background: var(--cream);
  }

  figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  figure:hover :global(img) {
    transform: scale(1.025);
  }

  .wide {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 8;
  }

  .wide :global(img) {
    object-position: center 46%;
  }

  .portrait {
    aspect-ratio: 4 / 5;
  }

  .portrait :global(img) {
    object-position: 63% center;
  }

  .square {
    aspect-ratio: 4 / 5;
  }

  .square :global(img) {
    object-position: 40% center;
  }

  .full {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 8;
  }

  .monochrome :global(img) {
    filter: grayscale(1);
  }

  figcaption {
    position: absolute;
    right: 18px;
    bottom: 18px;
    padding: 9px 14px;
    color: var(--forest-deep);
    background: var(--white);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 680px) {
    .gallery-grid {
      width: calc(100% - 24px);
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .wide,
    .full {
      grid-column: auto;
      aspect-ratio: 4 / 5;
    }

    .wide :global(img),
    .full :global(img) {
      object-position: center;
    }
  }
</style>
